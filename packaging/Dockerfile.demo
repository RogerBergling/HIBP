# Public demo image: fake data, fake SSH/helper/email/network/package actions.
# Build from the repository root:
#   docker build -f packaging/Dockerfile.demo -t hibp-demo .

FROM golang:1.27.4-alpine AS build

ARG VERSION=demo
ARG BUILD_NUMBER=demo
ARG BUILD_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG BUILD_TARGET=linux/amd64
ARG BUILD_TYPE=demo

ARG SQLCIPHER_VERSION=4.20.0

RUN apk add --no-cache \
    build-base \
    openssl-dev \
    openssl-libs-static \
    zlib-dev \
    zlib-static \
    zstd-dev \
    zstd-static \
    curl \
    perl \
    tar \
    linux-headers \
    ca-certificates

WORKDIR /src
COPY go.mod go.sum ./
COPY third_party ./third_party
COPY cmd ./cmd
COPY internal ./internal
RUN go mod download

RUN curl -fsSL \
      "https://github.com/sqlcipher/sqlcipher/archive/refs/tags/v${SQLCIPHER_VERSION}.tar.gz" \
      -o /tmp/sqlcipher.tar.gz \
    && tar -xzf /tmp/sqlcipher.tar.gz -C /tmp \
    && cd "/tmp/sqlcipher-${SQLCIPHER_VERSION}" \
    && CFLAGS="-DSQLITE_HAS_CODEC -DSQLCIPHER_CRYPTO_OPENSSL -DSQLITE_EXTRA_INIT=sqlcipher_extra_init -DSQLITE_EXTRA_SHUTDOWN=sqlcipher_extra_shutdown -DSQLITE_TEMP_STORE=2" LDFLAGS="-lcrypto" ./configure \
         --disable-shared \
         --enable-static \
         --disable-tcl \
    && make -j"$(nproc)" \
    && make install DESTDIR=/opt/sqlcipher \
    && ln -sf libsqlite3.a /opt/sqlcipher/usr/local/lib/libsqlcipher.a

RUN CGO_ENABLED=1 \
       CGO_CFLAGS="-I/opt/sqlcipher/usr/local/include" \
       CGO_LDFLAGS="-L/opt/sqlcipher/usr/local/lib -lsqlcipher -lssl -lcrypto -lz -lzstd -lm -lpthread -ldl" \
       go test -tags "demo sqlcipher_mattn libsqlcipher netgo osusergo sqlite_omit_load_extension" ./...

RUN mkdir -p /out /out/var/lib/hibp /out/tmp \
    && touch /out/tmp/.keep \
    && chmod 1777 /out/tmp \
    && CGO_ENABLED=1 \
       CGO_CFLAGS="-I/opt/sqlcipher/usr/local/include" \
       CGO_LDFLAGS="-L/opt/sqlcipher/usr/local/lib -lsqlcipher -lssl -lcrypto -lz -lzstd -lm -lpthread -ldl" \
       go build -trimpath \
         -tags "demo sqlcipher_mattn libsqlcipher netgo osusergo sqlite_omit_load_extension" \
         -ldflags "-s -w -linkmode external -extldflags '-static' -X main.version=${VERSION} -X main.buildNumber=${BUILD_NUMBER} -X main.buildCommit=${BUILD_COMMIT} -X main.buildDate=${BUILD_DATE} -X main.buildTarget=${BUILD_TARGET} -X main.buildType=${BUILD_TYPE}" \
         -o /out/hibp-demo ./cmd/hibp-demo \
    && file /out/hibp-demo \
    && (ldd /out/hibp-demo 2>&1 || true) | tee /tmp/ldd \
    && ! grep -q '=>' /tmp/ldd \
    && chown -R 65532:65532 /out/var/lib/hibp /out/tmp

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/hibp-demo /hibp-demo
# COPY creates the top-level destination directories owned by root. The demo
# runs as 65532 and must be able to create its ephemeral database in /tmp, so
# set ownership explicitly instead of relying on the source directory owner.
COPY --chown=65532:65532 --from=build /out/var /var
COPY --chown=65532:65532 --from=build /out/tmp /tmp
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/hibp-demo"]
