[Unit]
Description=HIBP - Have I Been Patched
Documentation=https://github.com/RogerBergling/HIBP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hibp
Group=hibp
ExecStart=/usr/local/bin/hibp server --db /var/lib/hibp/hibp.db --listen 127.0.0.1:8443
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hibp
StateDirectory=hibp
RuntimeDirectory=hibp
LimitCORE=0
LimitNOFILE=4096
CapabilityBoundingSet=
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

# Manual unlock note:
# The server prompts for the database passphrase on its controlling terminal.
# For a headless service, use a 0600 passphrase file with --passphrase-file and
# full-disk encryption, or start the service interactively for the first unlock.
# Do not store the passphrase in the unit file or environment.
