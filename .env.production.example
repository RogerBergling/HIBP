# Copy to .env.production and edit.
# Use with:
#   docker compose --env-file .env.production -f compose.production.yaml up -d

# latest or a pinned release tag such as v0.12.0
HIBP_TAG=latest

# Loopback is the supported default. A LAN HTTPS listener needs the built-in TLS
# flags, which are not included in this Compose example.
HIBP_LISTEN=127.0.0.1:8443

# Bind-mount paths on the Docker host. Prepare them before first start.
HIBP_DATA_DIR=/var/lib/hibp
HIBP_SSH_DIR=/etc/hibp/ssh
HIBP_PASSPHRASE_FILE=/etc/hibp/db.passphrase
