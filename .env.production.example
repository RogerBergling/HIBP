# Copy to .env.production and edit.
# Use with:
#   docker compose --env-file .env.production -f compose.production.yaml up -d
#
# Runtime data and secrets stay next to this file. The paths below are relative
# to compose.production.yaml.

# First-visit theme: dark, light or system (follows prefers-color-scheme).
# A visitor's saved theme toggle choice overrides this default.
APP_THEME=dark

# latest = newest release, edge = current main build, or pin a release such as
# v0.12.0. Use a pinned release or image digest for production.
HIBP_TAG=latest

# Loopback is the supported default. A LAN HTTPS listener needs the built-in TLS
# flags, which are not included in this Compose example.
HIBP_LISTEN=127.0.0.1:8443

# Self-contained deployment paths. Create these directories first and chown
# them to 65532:65532; see compose.production.yaml and README.md.
HIBP_DATA_DIR=./data
HIBP_SSH_DIR=./secrets/ssh
HIBP_PASSPHRASE_FILE=./secrets/db.passphrase
