# Copy to .env.demo and edit.
# Use with:
#   docker compose --env-file .env.demo up -d

# edge = latest main build, latest = latest release, or a version such as v0.12.0
HIBP_DEMO_TAG=edge

# Exact browser origin, including scheme and port when non-default.
# Local:  http://localhost:8080
# Public: https://demo.example.com
HIBP_DEMO_PUBLIC_URL=http://localhost:8080

# Allow a non-loopback http:// public URL. Use this only for a trusted LAN,
# together with an http:// LAN origin. Never expose it to the internet.
# LAN example:
#   HIBP_DEMO_PUBLIC_URL=http://192.168.1.50:8011
#   HIBP_DEMO_ALLOW_INSECURE_HTTP=true
#   HIBP_DEMO_BIND=0.0.0.0
#   HIBP_DEMO_PORT=8011
HIBP_DEMO_ALLOW_INSECURE_HTTP=false

# Host bind address and published port. The container always listens on 8080.
# Use HIBP_DEMO_PORT=8011 for http://localhost:8011. Do not change
# HIBP_DEMO_LISTEN to 8011.
# Keep 127.0.0.1 when a reverse proxy runs on the same host; use 0.0.0.0 only
# for LAN access, with a firewall and an HTTPS proxy in front.
HIBP_DEMO_BIND=127.0.0.1
HIBP_DEMO_PORT=8080
